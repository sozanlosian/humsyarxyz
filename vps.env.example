# ══════════════════════════════════════════════════════════════
# HumsYarX — نمونه‌ی env مخصوص استقرار VPS (🌊 VPS-DEPLOY)
# روی سرور:  cp vps.env.example .env
# بعد با nano .env مقادیر واقعی را بگذار.
# ⚠️ هرگز فایل .env واقعی را در گیت یا جای عمومی نگذار.
# ⭐ = حتماً باید عوض شود | بقیه پیش‌فرض سالم دارند
# ══════════════════════════════════════════════════════════════

# ── ⭐ دامنه و دیتابیس (الزامی) ──
DOMAIN=yourdomain.com
MONGO_USER=humsyar
MONGO_PASS=PUT-HEX-PASSWORD-HERE
# (MONGODB_URI را لازم نیست بنویسی؛ compose خودش از این دو می‌سازد:
#  mongodb://MONGO_USER:MONGO_PASS@mongo:27017/humsyar?authSource=admin)

# ── ⭐ تلگرام (الزامی) ──
TELEGRAM_TOKEN=123456:ABC...      # توکن ربات از BotFather
BOT_TOKEN=                        # خالی بماند (فقط fallback داخلی)
BOT_USERNAME=YourBot              # یوزرنیم ربات (بدون @) — برای لینک بازگشت درگاه
ADMIN_ID=123456789                # آیدی عددی تلگرام خودت (مالک) — از @userinfobot بگیر
CHANNEL_ID=                      # اختیاری (fallback کانال منابع)

# ── ⭐ آدرس‌ها (الزامی) ──
WEBAPP_URL=https://yourdomain.com/app   # ریشه‌ی مینی‌اپ (کال‌بک درگاه هم از همین ساخته می‌شود)
# PORT را این‌جا ننویس؛ compose خودش 8000 می‌گذارد.
CORS_ALLOW_CREDENTIALS=true

# ── زرین‌پال (درگاه پرداخت) ──
# خالی = حالت نمایشی mock (بدون پول واقعی)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=                  # 1/0؛ خالی = خودکار
ZARINPAL_CALLBACK_URL=            # اگر خالی: WEBAPP_URL + /payment/verify

# ── ربات: polling (پیش‌فرض سالم — دست نزن) ──
BOT_HEARTBEAT_FILE=
BOT_HEARTBEAT_INTERVAL=30
BOT_PROC_CACHE_TTL=10
BOT_WEBHOOK_MODE=                 # ⚠️ خالی نگه دار = polling (webhook روی تک‌پورت پشتیبانی نمی‌شود)
WEBHOOK_MODE=
WEBHOOK_URL=
BOT_WEBHOOK_URL=
WEBHOOK_SECRET=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_LISTEN=0.0.0.0
BOT_WEBHOOK_PORT=8001

# ── امنیت ──
API_DOCS_ENABLED=0                # 1 = بازکردن /docs (فقط dev)
FERNET_KEY=                       # توصیه‌شده: بعد از اولین بالا‌آمدن، با دستور داخل آموزش بساز و بگذار
AI_ENC_KEY=                       # fallback قدیمی FERNET_KEY
INIT_DATA_MAX_AGE_SEC=3600
INIT_NONCE_ENABLED=0

# ── ریت‌لیمیت ──
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_OTP_PER_10M=5
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_AI_IMAGE_PER_H=20
RATE_LIMIT_SUBMIT_PER_MIN=10

# ── کیف پول (تومان) ──
WALLET_DAILY_LIMIT=5000000
WALLET_LARGE_THRESHOLD=2000000

# ── برند و ظاهر ──
BRAND_NAME=HumsyarX
SPA_ASSET_404=1

# ── درون‌ریزی از URL ──
URLIMPORT_TMP=/tmp
URLIMPORT_TRUSTED_HOSTS=
URLIMPORT_MAX_CONCURRENT=2
URLIMPORT_MAX_REDIRECTS=5
URLIMPORT_MAX_RETRIES=3
URLIMPORT_CONNECT_TIMEOUT=10
URLIMPORT_READ_TIMEOUT=30
URLIMPORT_OVERALL_TIMEOUT=600

# ── فایل‌های بزرگ تلگرام (اختیاری؛ رینیم بالای ۲۰ مگ) ──
# اگر خالی: همان API ابری تلگرام استفاده می‌شود (تا ۲۰ مگ سالم است)
TELEGRAM_LOCAL_API_URL=
TELEGRAM_API_ID=                  # از my.telegram.org (برای MTProto)
TELEGRAM_API_HASH=

# ── HTTP داخلی ──
HTTP_MAX_CONNECTIONS=80
HTTP_MAX_KEEPALIVE=30
HTTP_KEEPALIVE_EXPIRY=30
HTTP_RETRY_MAX=2
HTTP_BROADCAST_CONCURRENCY=10

# ── بکاپ خودکار (فایل بکاپ به تلگرام ادمین ارسال می‌شود) ──
BACKUP_AUTO_KEEP=14               # نگه‌داشت (روز)
