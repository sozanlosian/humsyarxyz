+                'ai_image_count': {'$cond': [
+                    {'$eq': ['$ai_image_date', today]},
+                    {'$add': [{'$ifNull': ['$ai_image_count', 0]}, 1]}, 1]},
+                'ai_image_date': today,
+                'ai_image_total': {
+                    '$add': [{'$ifNull': ['$ai_image_total', 0]}, 1]},
+            }}])
+        u = await self.users.find_one({'user_id': int(uid)},
+                                      {'ai_image_count': 1})
+        return int((u or {}).get('ai_image_count') or 0)
